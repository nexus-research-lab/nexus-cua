          "format": "double"
        },
        "width": {
          "description": "Non-negative logical width.",
          "type": "number",
          "format": "double"
        },
        "x": {
          "description": "Logical left edge.",
          "type": "number",
          "format": "double"
        },
        "y": {
          "description": "Logical top edge.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "ScreenshotPoint": {
      "description": "An integer pixel coordinate in the exact screenshot artifact.",
      "type": "object",
      "properties": {
        "x": {
          "description": "Zero-based horizontal pixel coordinate.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "y": {
          "description": "Zero-based vertical pixel coordinate.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ]
    },
    "SensitiveText": {
      "description": "User input whose debug output is always redacted.",
      "type": "string"
    },
    "SessionId": {
      "description": "Runtime-issued identity for an authorized session.",
      "type": "string"
    },
    "SessionInput": {
      "description": "Input selecting one existing session.",
      "type": "object",
      "properties": {
        "session_id": {
          "description": "Runtime-issued session identity.",
          "$ref": "#/$defs/SessionId"
        }
      },
      "additionalProperties": false,
      "required": [
        "session_id"
      ]
    },
    "StatePredicate": {
      "description": "A deterministic predicate evaluated against fresh platform state.",
      "oneOf": [
        {
          "description": "Window title contains text using a case-sensitive comparison.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "window_title_contains"
            },
            "text": {
              "description": "Required title fragment.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ]
        },
        {
          "description": "At least one element matches the supplied semantic fields.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "element_exists"
            },
            "name": {
              "description": "Optional accessible-name constraint.",
              "type": [
                "string",
                "null"
              ]
            },
            "role": {
              "description": "Optional role constraint.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "At least one matching element has the requested semantic state.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "element_state"
            },
            "name": {
              "description": "Optional accessible-name constraint.",
              "type": [
                "string",
                "null"
              ]
            },
            "role": {
              "description": "Optional role constraint.",
              "type": [
                "string",
                "null"
              ]
            },
            "state": {
              "description": "Closed semantic state to compare.",
              "$ref": "#/$defs/ElementState"
            },
            "value": {
              "description": "Expected state value.",
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "state",
            "value"
          ]
        },
        {
          "description": "One observed rectangle remains within another.",
          "type": "object",
          "properties": {
            "inner": {
              "description": "Inner bounds.",
              "$ref": "#/$defs/ScreenRect"
            },
            "kind": {
              "type": "string",
              "const": "bounds_contained"
            },
            "outer": {
              "description": "Outer bounds.",
              "$ref": "#/$defs/ScreenRect"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "inner",
            "outer"
          ]
        }
      ]
    },
    "VerifyStateInput": {
      "description": "Deterministic verification input.",
      "type": "object",
      "properties": {
        "predicate": {
          "description": "Predicate evaluated against fresh state.",
          "$ref": "#/$defs/StatePredicate"
        },
        "session_id": {
          "description": "Runtime-issued session identity.",
          "$ref": "#/$defs/SessionId"
        },
        "window_ref": {
          "description": "Session-scoped target window.",
          "$ref": "#/$defs/WindowRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "session_id",
        "window_ref",
        "predicate"
      ]
    },
    "WindowRef": {
      "description": "Session-scoped opaque window reference.",
      "type": "string"
    },
    "WriteClipboardInput": {
      "description": "Input for a guarded plain-text clipboard replacement.",
      "type": "object",
      "properties": {
        "clipboard_ref": {
          "description": "Fresh snapshot guard proving the clipboard was inspected before write.",
          "$ref": "#/$defs/ClipboardRef"
        },
        "session_id": {
          "description": "Runtime-issued session identity with clipboard-write authority.",
          "$ref": "#/$defs/SessionId"
        },
        "text": {
          "description": "Replacement text. Debug output is always redacted.",
          "$ref": "#/$defs/SensitiveText"
        }
      },
      "additionalProperties": false,
      "required": [
        "session_id",
        "clipboard_ref",
        "text"
      ]
    }
  }
}
