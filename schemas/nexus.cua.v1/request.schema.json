      "properties": {
        "request_id": {
          "description": "Original host-generated mutation identity.",
          "$ref": "#/$defs/RequestId"
        },
        "wait_ms": {
          "description": "Maximum time to wait for an already-admitted mutation to finish.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request_id",
        "wait_ms"
      ]
