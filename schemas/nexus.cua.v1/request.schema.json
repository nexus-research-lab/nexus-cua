      "description": "Identity for one immutable window or display observation.",
      "type": "string"
    },
    "ObserveDisplayInput": {
      "description": "Input for capturing one exact physical display.",
      "type": "object",
      "properties": {
        "display_ref": {
          "description": "Session-scoped target returned by display enumeration.",
          "$ref": "#/$defs/DisplayRef"
        },
        "session_id": {
          "description": "Runtime-issued session identity.",
          "$ref": "#/$defs/SessionId"
        }
      },
      "additionalProperties": false,
      "required": [
        "session_id",
        "display_ref"
      ]
    },
    "ObserveWindowInput": {
      "description": "Input for capturing one exact window.",
      "type": "object",
      "properties": {
        "accessibility": {
          "description": "Requested bounded semantic-tree view.",
          "$ref": "#/$defs/AccessibilityMode"
        },
        "include_screenshot": {
          "description": "Whether to produce a transient PNG artifact.",
          "type": "boolean"
        },
        "session_id": {
          "description": "Runtime-issued session identity.",
          "$ref": "#/$defs/SessionId"
        },
        "window_ref": {
          "description": "Session-scoped target window.",
          "$ref": "#/$defs/WindowRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "session_id",
        "window_ref",
        "include_screenshot",
        "accessibility"
      ]
    },
    "OpenSessionInput": {
      "description": "Input for opening one isolated runtime session.",
      "type": "object",
      "properties": {
        "manifest": {
          "description": "Host-reviewed capability manifest.",
          "$ref": "#/$defs/CapabilityManifest"
        }
      },
      "additionalProperties": false,
      "required": [
        "manifest"
      ]
    },
    "PerformActionInput": {
      "description": "Mutation input bound to exact session, window, and observation identities.",
      "type": "object",
      "properties": {
        "action": {
          "description": "Authorized action.",
          "$ref": "#/$defs/Action"
        },
        "observation_id": {
          "description": "Fresh observation guarding the action.",
          "$ref": "#/$defs/ObservationId"
        },
        "session_id": {
          "description": "Runtime-issued session identity.",
          "$ref": "#/$defs/SessionId"
        },
        "window_ref": {
          "description": "Session-scoped target window.",
          "$ref": "#/$defs/WindowRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "session_id",
        "window_ref",
        "observation_id",
        "action"
      ]
    },
    "PermissionMode": {
      "description": "Capability mode fixed for the lifetime of a session.",
      "oneOf": [
        {
          "description": "Observation and deterministic verification only.",
          "type": "string",
          "const": "read_only"
        },
        {
          "description": "Only exact applications and action categories declared in the manifest.",
          "type": "string",
          "const": "bounded"
        }
      ]
    },
    "PointerButton": {
      "description": "Pointer button used by pixel actions.",
      "oneOf": [
        {
          "description": "Primary button.",
          "type": "string",
          "const": "left"
        },
        {
          "description": "Auxiliary button.",
          "type": "string",
          "const": "middle"
        },
        {
          "description": "Secondary button.",
          "type": "string",
          "const": "right"
        }
      ]
    },
    "ReadClipboardInput": {
      "description": "Input for one separately authorized clipboard read.",
      "type": "object",
      "properties": {
        "session_id": {
          "description": "Runtime-issued session identity with clipboard-read authority.",
