{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RequestEnvelope",
  "description": "Authenticated request sent over a private local transport.",
  "type": "object",
  "properties": {
    "authorization": {
      "description": "Host-issued transport token.",
      "$ref": "#/$defs/AuthorizationToken"
    },
    "command": {
      "description": "Exact requested operation.",
      "$ref": "#/$defs/Command"
    },
    "protocol_version": {
      "description": "Must equal [`crate::PROTOCOL_VERSION`].",
      "type": "string"
    },
    "request_id": {
      "description": "Client-generated request identity.",
      "$ref": "#/$defs/RequestId"
    },
    "timeout_ms": {
      "description": "End-to-end caller deadline in milliseconds, bounded by the service.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "request_id",
    "timeout_ms",
    "authorization",
    "command"
  ],
  "$defs": {
    "AccessibilityMode": {
      "description": "Requested semantic-tree detail for an observation.",
      "oneOf": [
        {
          "description": "Do not query the platform accessibility provider.",
          "type": "string",
          "const": "disabled"
        },
        {
          "description": "Actionable elements plus their minimum ancestor hierarchy.",
          "type": "string",
          "const": "interactive"
        },
        {
          "description": "A bounded diagnostic control-view tree.",
          "type": "string",
          "const": "full"
        }
      ]
    },
    "Action": {
      "description": "One authorized desktop mutation.",
      "oneOf": [
        {
          "description": "Brings the exact target window to the foreground.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "focus_window"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Moves and resizes the exact target window in logical screen coordinates.",
          "type": "object",
          "properties": {
            "bounds": {
              "description": "Requested logical top-left screen bounds.",
              "$ref": "#/$defs/ScreenRect"
            },
            "kind": {
              "type": "string",
              "const": "set_window_bounds"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "bounds"
          ]
        },
        {
          "description": "Changes the minimized state of the exact target window.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "set_window_minimized"
            },
            "minimized": {
              "description": "`true` minimizes and `false` restores the window without granting\nforeground keyboard or pointer input.",
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "minimized"
          ]
        },
        {
          "description": "Requests cooperative termination of the exact guarded application's\ncurrent process generation.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "terminate_application"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Moves semantic keyboard focus to an observed element.",
          "type": "object",
          "properties": {
            "element_ref": {
              "description": "Element scoped to the bound observation.",
              "$ref": "#/$defs/ElementRef"
            },
            "kind": {
              "type": "string",
              "const": "focus_element"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "element_ref"
          ]
        },
        {
          "description": "Invokes an element from the bound observation.",
          "type": "object",
          "properties": {
            "element_ref": {
              "description": "Element scoped to the bound observation.",
              "$ref": "#/$defs/ElementRef"
            },
            "kind": {
              "type": "string",
              "const": "invoke_element"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "element_ref"
          ]
        },
        {
          "description": "Clicks a point inside the observed window.",
          "type": "object",
          "properties": {
            "button": {
              "description": "Pointer button.",
              "$ref": "#/$defs/PointerButton"
            },
            "count": {
              "description": "Number of clicks, limited by the runtime.",
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "delivery": {
              "description": "Requested delivery route. Omission preserves the foreground v0.1\nbehavior for older trusted hosts.",
              "$ref": "#/$defs/DeliveryPreference",
              "default": "foreground"
            },
            "kind": {
              "type": "string",
              "const": "click_point"
            },
            "point": {
              "description": "Integer coordinate in the guarded screenshot artifact.",
              "$ref": "#/$defs/ScreenshotPoint"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "point",
            "button",
            "count"
          ]
        },
        {
          "description": "Holds one pointer button at a point, then always releases it in the same dispatch.",
          "type": "object",
          "properties": {
            "button": {
              "description": "Pointer button.",
              "$ref": "#/$defs/PointerButton"
            },
            "duration_ms": {
              "description": "Bounded hold duration in milliseconds.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "press_point"
            },
            "point": {
              "description": "Integer coordinate in the guarded screenshot artifact.",
              "$ref": "#/$defs/ScreenshotPoint"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "point",
            "button",
            "duration_ms"
          ]
        },
        {
          "description": "Replaces an accessibility element value.",
          "type": "object",
          "properties": {
            "element_ref": {
              "description": "Element scoped to the bound observation.",
              "$ref": "#/$defs/ElementRef"
            },
            "kind": {
              "type": "string",
              "const": "set_value"
            },
            "value": {
              "description": "Sensitive value that must not enter logs.",
              "$ref": "#/$defs/SensitiveText"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "element_ref",
            "value"
          ]
        },
        {
          "description": "Sets a numeric range control to an absolute value advertised by the\nguarded accessibility observation.",
          "type": "object",
          "properties": {
            "element_ref": {
              "description": "Element scoped to the bound observation.",
              "$ref": "#/$defs/ElementRef"
            },
            "kind": {
              "type": "string",
              "const": "set_range_value"
            },
            "value": {
              "description": "Finite value within the observed inclusive range.",
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "element_ref",
            "value"
          ]
        },
        {
          "description": "Toggles an accessibility element through its semantic pattern.",
          "type": "object",
          "properties": {
            "element_ref": {
              "description": "Element scoped to the bound observation.",
              "$ref": "#/$defs/ElementRef"
            },
            "kind": {
              "type": "string",
              "const": "toggle_element"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "element_ref"
          ]
        },
        {
          "description": "Selects an accessibility element through its semantic pattern.",
          "type": "object",
          "properties": {
            "element_ref": {
              "description": "Element scoped to the bound observation.",
              "$ref": "#/$defs/ElementRef"
            },
            "kind": {
              "type": "string",
              "const": "select_element"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "element_ref"
          ]
        },
        {
          "description": "Expands or collapses an accessibility element.",
          "type": "object",
          "properties": {
            "element_ref": {
              "description": "Element scoped to the bound observation.",
              "$ref": "#/$defs/ElementRef"
            },
            "expanded": {
              "description": "Desired expanded state.",
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "const": "set_expanded"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "element_ref",
            "expanded"
          ]
        },
        {
          "description": "Moves the system pointer to a screenshot pixel without clicking.",
          "type": "object",
          "properties": {
            "duration_ms": {
              "description": "Bounded movement duration in milliseconds.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "move_pointer"
            },
            "point": {
              "description": "Integer coordinate in the guarded screenshot artifact.",
              "$ref": "#/$defs/ScreenshotPoint"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "point",
            "duration_ms"
          ]
        },
        {
          "description": "Types text into the current target through foreground input.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "type_text"
            },
            "text": {
              "description": "Sensitive text that must not enter logs.",
              "$ref": "#/$defs/SensitiveText"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ]
        },
        {
          "description": "Presses a normalized keyboard chord such as `meta+a`.",
          "type": "object",
          "properties": {
            "keys": {
              "description": "Normalized non-empty key chord.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "const": "press_keys"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "keys"
          ]
        },
        {
          "description": "Scrolls by physical pixel deltas.",
          "type": "object",
          "properties": {
            "delta_x": {
              "description": "Horizontal delta.",
              "type": "number",
              "format": "double"
            },
            "delta_y": {
              "description": "Vertical delta.",
              "type": "number",
              "format": "double"
            },
            "element_ref": {
              "description": "Optional semantic target.",
              "anyOf": [
                {
                  "$ref": "#/$defs/ElementRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "scroll"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "delta_x",
            "delta_y"
          ]
        },
        {
          "description": "Drags between two points inside the observed window.",
          "type": "object",
          "properties": {
            "duration_ms": {
              "description": "Bounded duration in milliseconds.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "from": {
              "description": "Starting point.",
              "$ref": "#/$defs/ScreenshotPoint"
            },
            "kind": {
              "type": "string",
              "const": "drag"
            },
            "to": {
              "description": "Ending point.",
              "$ref": "#/$defs/ScreenshotPoint"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "from",
            "to",
            "duration_ms"
          ]
        }
      ]
    },
    "ActionKind": {
      "description": "Stable action category used by bounded capability manifests.",
      "oneOf": [
        {
          "description": "Focus or activate a target window.",
          "type": "string",
          "const": "focus_window"
        },
        {
          "description": "Move and resize a target window through an operating-system window API.",
          "type": "string",
          "const": "set_window_bounds"
        },
        {
          "description": "Minimize or restore a target window.",
          "type": "string",
          "const": "set_window_minimized"
        },
        {
          "description": "Cooperatively terminate the exact application process generation.",
          "type": "string",
          "const": "terminate_application"
        },
        {
          "description": "Move semantic keyboard focus to an accessibility element.",
          "type": "string",
          "const": "focus_element"
        },
        {
          "description": "Invoke an accessibility element's primary action.",
          "type": "string",
          "const": "invoke_element"
        },
        {
          "description": "Click at a physical pixel coordinate.",
          "type": "string",
          "const": "click_point"
        },
        {
          "description": "Press and release a pointer button after a bounded hold.",
          "type": "string",
          "const": "press_point"
        },
        {
          "description": "Replace an accessibility value.",
          "type": "string",
          "const": "set_value"
        },
        {
          "description": "Set a bounded numeric accessibility range value.",
          "type": "string",
          "const": "set_range_value"
        },
        {
          "description": "Toggle a semantic element.",
          "type": "string",
          "const": "toggle_element"
        },
        {
          "description": "Select a semantic element.",
          "type": "string",
          "const": "select_element"
        },
        {
          "description": "Expand or collapse a semantic element.",
          "type": "string",
          "const": "set_expanded"
        },
        {
          "description": "Move the pointer without clicking.",
          "type": "string",
          "const": "move_pointer"
        },
        {
          "description": "Type text through the foreground input path.",
          "type": "string",
          "const": "type_text"
        },
        {
          "description": "Press one keyboard chord.",
          "type": "string",
          "const": "press_keys"
        },
        {
          "description": "Scroll a semantic element or pixel surface.",
          "type": "string",
          "const": "scroll"
        },
        {
          "description": "Drag between two physical pixel coordinates.",
          "type": "string",
          "const": "drag"
        }
      ]
    },
    "AppRef": {
      "description": "Session-scoped opaque application reference.",
      "type": "string"
    },
    "AuthorizationToken": {
      "description": "Transport authorization token whose debug output is always redacted.",
      "type": "string"
    },
    "CapabilityManifest": {
      "description": "Exact, host-reviewed session authority.",
      "type": "object",
      "properties": {
        "allow_clipboard_read": {
          "description": "Whether bounded plain-text clipboard reads are allowed.",
          "type": "boolean",
          "default": false
        },
        "allow_clipboard_write": {
          "description": "Whether guarded plain-text clipboard replacement is allowed.",
          "type": "boolean",
          "default": false
        },
        "allow_display_capture": {
          "description": "Whether read-only capture of an exact physical display is allowed.",
          "type": "boolean",
          "default": false
        },
        "allow_foreground_input": {
          "description": "Whether any foreground input route is allowed.",
          "type": "boolean"
        },
        "allowed_actions": {
          "description": "Exact mutation categories allowed in bounded mode.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionKind"
          }
        },
        "application_refs": {
          "description": "Exact running process generations selected from trusted-host discovery.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiscoveryRef"
          }
        },
        "mode": {
          "description": "Session mode. There is deliberately no unrestricted value.",
          "$ref": "#/$defs/PermissionMode"
        },
        "restore_foreground_after_input": {
          "description": "Whether temporary foreground input should restore the exact prior owner.",
          "type": "boolean"
        },
        "ttl_seconds": {
          "description": "Finite lifetime in seconds.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "mode",
        "application_refs",
        "allowed_actions",
        "allow_foreground_input",
        "restore_foreground_after_input",
        "ttl_seconds"
      ]
    },
    "ClipboardRef": {
      "description": "Session-scoped opaque guard for one transient clipboard generation.",
      "type": "string"
    },
    "Command": {
      "description": "Exact public operation. Unknown variants or fields are rejected.",
      "oneOf": [
        {
          "description": "Read driver and protocol capabilities.",
          "type": "object",
          "properties": {
            "operation": {
              "type": "string",
              "const": "get_capabilities"
            }
          },
          "additionalProperties": false,
          "required": [
            "operation"
          ]
        },
        {
          "description": "Read current system permission state.",
          "type": "object",
          "properties": {
            "operation": {
              "type": "string",
              "const": "get_permission_status"
            }
          },
          "additionalProperties": false,
          "required": [
            "operation"
          ]
        },
        {
          "description": "Discover running applications for an authenticated policy host.",
          "type": "object",
          "properties": {
            "operation": {
              "type": "string",
              "const": "discover_applications"
            }
          },
          "additionalProperties": false,
          "required": [
            "operation"
          ]
        },
        {
          "description": "Discover installed applications through bounded native registration sources.",
          "type": "object",
          "properties": {
            "operation": {
              "type": "string",
              "const": "discover_launchable_applications"
            }
          },
          "additionalProperties": false,
          "required": [
            "operation"
          ]
        },
        {
          "description": "Launch one freshly discovered installed application identity.",
          "type": "object",
          "properties": {
            "input": {
              "$ref": "#/$defs/LaunchApplicationInput"
            },
            "operation": {
              "type": "string",
              "const": "launch_application"
            }
          },
          "additionalProperties": false,
          "required": [
            "operation",
            "input"
          ]
        },
        {
          "description": "Open one isolated authorized session.",
          "type": "object",
          "properties": {
            "input": {
              "$ref": "#/$defs/OpenSessionInput"
            },
            "operation": {
              "type": "string",
              "const": "open_session"
            }
          },
          "additionalProperties": false,
          "required": [
            "operation",
            "input"
          ]
        },
        {
          "description": "Close a session and delete its transient artifacts.",
          "type": "object",
          "properties": {
            "input": {
              "$ref": "#/$defs/SessionInput"
            },
            "operation": {
              "type": "string",
              "const": "close_session"
            }
          },
          "additionalProperties": false,
          "required": [
            "operation",
            "input"
          ]
        },
        {
          "description": "List allowed running applications.",
          "type": "object",
          "properties": {
            "input": {
              "$ref": "#/$defs/SessionInput"
            },
            "operation": {
              "type": "string",
              "const": "list_apps"
            }
          },
          "additionalProperties": false,
          "required": [
            "operation",
            "input"
          ]
        },
        {
          "description": "List allowed top-level windows.",
          "type": "object",
          "properties": {
            "input": {
              "$ref": "#/$defs/ListWindowsInput"
            },
            "operation": {
              "type": "string",
              "const": "list_windows"
            }
          },
          "additionalProperties": false,
          "required": [
            "operation",
            "input"
          ]
        },
        {
          "description": "List exact physical displays under separate read-only authority.",
          "type": "object",
          "properties": {
            "input": {
              "$ref": "#/$defs/SessionInput"
            },
            "operation": {
              "type": "string",
              "const": "list_displays"
            }
          },
          "additionalProperties": false,
          "required": [
            "operation",
            "input"
          ]
        },
        {
          "description": "Capture one exact window.",
          "type": "object",
          "properties": {
            "input": {
              "$ref": "#/$defs/ObserveWindowInput"
            },
            "operation": {
              "type": "string",
              "const": "observe_window"
            }
          },
          "additionalProperties": false,
          "required": [
            "operation",
            "input"
          ]
        },
        {
          "description": "Capture one exact physical display for desktop overview.",
          "type": "object",
          "properties": {
            "input": {
              "$ref": "#/$defs/ObserveDisplayInput"
            },
            "operation": {
              "type": "string",
              "const": "observe_display"
            }
          },
          "additionalProperties": false,
          "required": [
            "operation",
            "input"
          ]
        },
        {
          "description": "Read bounded plain text under separate clipboard authority.",
          "type": "object",
          "properties": {
            "input": {
              "$ref": "#/$defs/ReadClipboardInput"
            },
            "operation": {
              "type": "string",
              "const": "read_clipboard"
            }
          },
          "additionalProperties": false,
          "required": [
            "operation",
            "input"
          ]
        },
        {
          "description": "Replace plain text only when a fresh clipboard guard still matches.",
          "type": "object",
          "properties": {
            "input": {
              "$ref": "#/$defs/WriteClipboardInput"
            },
            "operation": {
              "type": "string",
              "const": "write_clipboard"
            }
          },
          "additionalProperties": false,
          "required": [
            "operation",
            "input"
          ]
        },
        {
          "description": "Execute one mutation bound to a fresh observation.",
          "type": "object",
          "properties": {
            "input": {
              "$ref": "#/$defs/PerformActionInput"
            },
            "operation": {
              "type": "string",
              "const": "perform_action"
            }
          },
          "additionalProperties": false,
          "required": [
            "operation",
            "input"
          ]
        },
        {
          "description": "Query one prior mutation identity without dispatching it again.",
          "type": "object",
          "properties": {
            "input": {
              "$ref": "#/$defs/ReconcileMutationInput"
            },
            "operation": {
              "type": "string",
              "const": "reconcile_mutation"
            }
          },
          "additionalProperties": false,
          "required": [
            "operation",
            "input"
          ]
        },
        {
          "description": "Evaluate a deterministic predicate against fresh state.",
          "type": "object",
          "properties": {
            "input": {
              "$ref": "#/$defs/VerifyStateInput"
            },
            "operation": {
              "type": "string",
              "const": "verify_state"
            }
          },
          "additionalProperties": false,
          "required": [
            "operation",
            "input"
          ]
        }
      ]
    },
    "DeliveryPreference": {
      "description": "Caller-selected delivery ceiling for pixel actions that support both routes.",
      "oneOf": [
        {
          "description": "Route to the exact target without activating it, or fail explicitly.",
          "type": "string",
          "const": "background"
        },
        {
          "description": "Use the system foreground pointer route.",
          "type": "string",
          "const": "foreground"
        }
      ]
    },
    "DiscoveryRef": {
      "description": "Short-lived runtime-local reference for one discovered process generation.",
      "type": "string"
    },
    "DisplayRef": {
      "description": "Session-scoped opaque display reference.",
      "type": "string"
    },
    "ElementRef": {
      "description": "Observation-scoped opaque accessibility element reference.",
      "type": "string"
    },
    "ElementState": {
      "description": "A deterministic predicate evaluated against fresh platform state.",
      "oneOf": [
        {
          "description": "Whether the element accepts actions.",
          "type": "string",
          "const": "enabled"
        },
        {
          "description": "Whether the element owns keyboard focus.",
          "type": "string",
          "const": "focused"
        },
        {
          "description": "Whether the platform reports the element as selected.",
          "type": "string",
          "const": "selected"
        },
        {
          "description": "Whether the platform reports the element as checked.",
          "type": "string",
          "const": "checked"
        },
        {
          "description": "Whether the platform reports the element as expanded.",
          "type": "string",
          "const": "expanded"
        }
      ]
    },
    "LaunchApplicationInput": {
      "description": "Explicit host authority for one cold application launch.",
