        "launch_ref": {
          "description": "Fresh opaque identity from installed-application discovery.",
          "$ref": "#/$defs/LaunchRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "launch_ref",
        "allow_foreground_activation"
      ]
    },
    "LaunchRef": {
      "description": "Short-lived runtime-local reference for one reviewed installed application identity.",
      "type": "string"
