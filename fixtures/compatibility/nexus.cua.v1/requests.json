[
  {
    "protocol_version": "nexus.cua.v1",
    "request_id": "fixture-capabilities",
    "timeout_ms": 30000,
    "authorization": "fixture-transport-token",
    "command": { "operation": "get_capabilities" }
  },
  {
    "protocol_version": "nexus.cua.v1",
    "request_id": "fixture-permissions",
    "timeout_ms": 30000,
    "authorization": "fixture-transport-token",
    "command": { "operation": "get_permission_status" }
  },
  {
    "protocol_version": "nexus.cua.v1",
    "request_id": "fixture-discovery",
    "timeout_ms": 30000,
    "authorization": "fixture-transport-token",
    "command": { "operation": "discover_applications" }
  },
  {
    "protocol_version": "nexus.cua.v1",
    "request_id": "fixture-launch-discovery",
    "timeout_ms": 30000,
    "authorization": "fixture-transport-token",
    "command": { "operation": "discover_launchable_applications" }
  },
  {
    "protocol_version": "nexus.cua.v1",
    "request_id": "fixture-launch",
    "timeout_ms": 30000,
    "authorization": "fixture-transport-token",
    "command": {
      "operation": "launch_application",
      "input": {
        "launch_ref": "launch_fixture",
        "allow_foreground_activation": true
      }
    }
  },
  {
    "protocol_version": "nexus.cua.v1",
    "request_id": "fixture-open-session",
    "timeout_ms": 30000,
    "authorization": "fixture-transport-token",
    "command": {
      "operation": "open_session",
      "input": {
        "manifest": {
          "mode": "bounded",
          "application_refs": ["discovery_fixture"],
          "allowed_actions": ["focus_window", "invoke_element", "set_range_value", "click_point"],
          "allow_foreground_input": true,
          "restore_foreground_after_input": true,
          "allow_display_capture": true,
          "allow_clipboard_read": true,
          "allow_clipboard_write": true,
          "ttl_seconds": 300
        }
      }
    }
  },
  {
    "protocol_version": "nexus.cua.v1",
    "request_id": "fixture-close-session",
    "timeout_ms": 30000,
    "authorization": "fixture-transport-token",
    "command": {
      "operation": "close_session",
      "input": { "session_id": "session_fixture" }
    }
  },
  {
    "protocol_version": "nexus.cua.v1",
    "request_id": "fixture-list-apps",
    "timeout_ms": 30000,
    "authorization": "fixture-transport-token",
    "command": {
      "operation": "list_apps",
      "input": { "session_id": "session_fixture" }
    }
  },
  {
    "protocol_version": "nexus.cua.v1",
    "request_id": "fixture-list-windows",
    "timeout_ms": 30000,
    "authorization": "fixture-transport-token",
    "command": {
      "operation": "list_windows",
      "input": { "session_id": "session_fixture", "app_ref": "app_fixture" }
    }
  },
  {
    "protocol_version": "nexus.cua.v1",
    "request_id": "fixture-list-displays",
    "timeout_ms": 30000,
    "authorization": "fixture-transport-token",
    "command": {
      "operation": "list_displays",
      "input": { "session_id": "session_fixture" }
    }
  },
  {
    "protocol_version": "nexus.cua.v1",
    "request_id": "fixture-observe-display",
    "timeout_ms": 30000,
    "authorization": "fixture-transport-token",
    "command": {
      "operation": "observe_display",
      "input": {
        "session_id": "session_fixture",
        "display_ref": "display_fixture"
      }
    }
  },
  {
    "protocol_version": "nexus.cua.v1",
    "request_id": "fixture-observe",
    "timeout_ms": 30000,
    "authorization": "fixture-transport-token",
    "command": {
      "operation": "observe_window",
      "input": {
        "session_id": "session_fixture",
        "window_ref": "window_fixture",
        "include_screenshot": true,
        "accessibility": "interactive"
      }
    }
  },
  {
    "protocol_version": "nexus.cua.v1",
    "request_id": "fixture-read-clipboard",
    "timeout_ms": 30000,
    "authorization": "fixture-transport-token",
    "command": {
      "operation": "read_clipboard",
      "input": { "session_id": "session_fixture" }
    }
  },
  {
    "protocol_version": "nexus.cua.v1",
    "request_id": "fixture-write-clipboard",
    "timeout_ms": 30000,
    "authorization": "fixture-transport-token",
    "command": {
      "operation": "write_clipboard",
      "input": {
        "session_id": "session_fixture",
        "clipboard_ref": "clipboard_fixture",
        "text": "replacement fixture"
      }
    }
  },
  {
    "protocol_version": "nexus.cua.v1",
    "request_id": "fixture-action",
    "timeout_ms": 30000,
    "authorization": "fixture-transport-token",
    "command": {
      "operation": "perform_action",
      "input": {
        "session_id": "session_fixture",
        "window_ref": "window_fixture",
        "observation_id": "observation_fixture",
        "action": { "kind": "focus_window" }
      }
    }
  },
  {
    "protocol_version": "nexus.cua.v1",
    "request_id": "fixture-verify",
    "timeout_ms": 30000,
    "authorization": "fixture-transport-token",
    "command": {
      "operation": "verify_state",
      "input": {
        "session_id": "session_fixture",
        "window_ref": "window_fixture",
        "predicate": {
          "kind": "element_state",
          "role": "checkbox",
          "name": "Remember me",
          "state": "checked",
          "value": true
        }
      }
    }
  },
  {
    "protocol_version": "nexus.cua.v1",
    "request_id": "fixture-reconcile-call",
    "timeout_ms": 30000,
    "authorization": "fixture-transport-token",
    "command": {
      "operation": "reconcile_mutation",
      "input": {
        "request_id": "fixture-action",
        "wait_ms": 0
      }
    }
  }
